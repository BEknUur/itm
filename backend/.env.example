# Copy to backend/.env. Read by app/core/config.py (Settings); every var is optional.
# In Docker, DATABASE_URL and CORS_ORIGINS come from docker-compose.yml instead.

SAFESTEP_DATABASE_URL=postgresql+asyncpg://safestep:safestep@localhost:5433/safestep
# Railway service variable: SAFESTEP_DATABASE_URL=${{Postgres.DATABASE_URL}}
# Standard postgres:// and postgresql:// URIs are normalized to asyncpg automatically.
# Railway supplies PORT; Docker defaults to 8000 when it is absent.
SAFESTEP_TEST_DATABASE_URL=postgresql+asyncpg://safestep:safestep@localhost:5433/safestep_test
SAFESTEP_CORS_ORIGINS=["http://localhost:5173"]

# Per-bank risk tuning
SAFESTEP_RISK_THRESHOLD=50            # 1..100, score at which a payment is held
SAFESTEP_HOLD_MINUTES=30              # 30..120
SAFESTEP_UNUSUAL_AMOUNT_MULTIPLIER=3.0
SAFESTEP_LARGE_P2P_AMOUNT=500000      # KZT
SAFESTEP_FAILED_OTP_MIN=2
SAFESTEP_MAX_STEP_UP_ATTEMPTS=3
